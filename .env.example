# Copy to .env and fill in (install.sh does the copy). .env is git-ignored — never commit it.
# Used by bin/ds and scripts/ds-check.sh. The names say DEEPSEEK, but any endpoint works.

# Base URL of your gateway/server, without a trailing slash.
#   e.g. http://10.0.0.5:8000   or   https://llm.example.com   (with or without /v1)
DEEPSEEK_BASE_URL=

# API key/token your server expects. Leave empty if it has none.
DEEPSEEK_API_KEY=

# Model id exactly as the server lists it (run: ./scripts/ds-check.sh models)
DEEPSEEK_MODEL=

# What the server speaks. ds needs anthropic (/v1/messages); ds-check.sh tests both.
DEEPSEEK_API_FORMAT=anthropic
